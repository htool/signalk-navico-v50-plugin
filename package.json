{
  "name": "signalk-navico-v50-plugin",
  "version": "0.1.0",
  "description": "Emulate a B&G V60/V50 VHF on NMEA 2000 so Zeus Call is enabled, with a DSC call-flow webapp",
  "main": "plugin/index.js",
  "scripts": {
    "test": "node --test test/*.test.js && node scripts/test-npm-publish-check.js",
    "standalone": "node scripts/standalone.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-hardware",
    "signalk-webapp"
  ],
  "author": "hans@defect.org",
  "license": "ISC",
  "signalk": {
    "displayName": "Navico V60 (DSC)",
    "recommends": [
      "signalk-icom-m510e-plugin"
    ]
  },
  "signalk-plugin-enabled-by-default": false,
  "files": [
    "plugin",
    "lib",
    "public",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htool/signalk-navico-v50-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/htool/signalk-navico-v50-plugin/issues"
  },
  "homepage": "https://github.com/htool/signalk-navico-v50-plugin#readme",
  "dependencies": {
    "@canboat/canboatjs": "^2.12.0",
    "debug": "^4.3.4"
  }
}
